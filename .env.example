# Canonical origin used for metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://aot-archive.vercel.app

# ── Authored 3D models ──────────────────────────────────────────────────────
# The seven hero models ship in public/models/ and are served locally by
# default (`/models`), so this works with no .env setup at all.
#
# Optional: point at a CDN / static bucket instead of the local files.
# NEXT_PUBLIC_MODELS_BASE_URL=https://cdn.example.com/aot-models
#
# Per-slot overrides (absolute URLs) — only needed if a slot lives elsewhere:
# NEXT_PUBLIC_MODEL_WALL_GATE_URL=
# NEXT_PUBLIC_MODEL_COLOSSAL_HEAD_URL=
# NEXT_PUBLIC_MODEL_EREN_URL=
# NEXT_PUBLIC_MODEL_MIKASA_URL=
# NEXT_PUBLIC_MODEL_LEVI_URL=
# NEXT_PUBLIC_MODEL_ATTACK_TITAN_URL=
# NEXT_PUBLIC_MODEL_ODM_GEAR_URL=
# NEXT_PUBLIC_MODEL_PURE_TITAN_URL=
# NEXT_PUBLIC_MODEL_COLOSSAL_FULL_URL=
# NEXT_PUBLIC_MODEL_FEMALE_TITAN_URL=
# NEXT_PUBLIC_MODEL_TROST_BUILDING_URL=
# NEXT_PUBLIC_MODEL_TROST_DISTRICT_URL=
# NEXT_PUBLIC_MODEL_BOULDER_URL=
# NEXT_PUBLIC_MODEL_BASEMENT_ROOM_URL=
#
# The Draco decoder is bundled in public/draco/ (three r169). Override only if
# you host the decoder elsewhere.
# NEXT_PUBLIC_DRACO_DECODER_PATH=/draco/

# Force a quality tier for QA — high | medium | low
# NEXT_PUBLIC_FORCE_QUALITY=
